# Gemini API Key (Required for AI visual reasoning & autonomous decision-making)
GEMINI_API_KEY=your_gemini_api_key_here

# Agent Model (Recommended: gemini-3.7-flash or gemini-2.5-flash)
GEMINI_MODEL=gemini-3.7-flash

# Execution Settings
BROWSER_HEADLESS=false
MAX_STEPS=30
LOOP_THRESHOLD=3
ACTION_DELAY_MS=600

# Server Settings
PORT=8000
HOST=127.0.0.1
